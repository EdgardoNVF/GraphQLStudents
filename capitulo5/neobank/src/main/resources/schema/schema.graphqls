extend schema
  @link(
    url: "https://specs.apollo.dev/federation/v2.3"
    import: ["@key"]
  )



# Representa las operaciones y tipos de datos disponibles en NeoBank


# Consulta raíz
type Query {
    cliente(id: ID!): Cliente
}

# tipo cliente
type Cliente @key(fields: "id"){
    id: ID!
    nombre: String!
    cuentas: [Cuenta!]!
}

# tipo cuenta
type Cuenta {
    numero: ID!
    saldo: Float!
    moneda: String!
    transacciones: [Transaccion!]!
    estadisticasMovimientos: EstadisticasMovimientos!
}

type EstadisticasMovimientos {
    cantidad: Int!
    montoTotal: Float!
}

# tipo transaccion
type Transaccion {
    id: ID!
    amount: Float!
    status: String!
}