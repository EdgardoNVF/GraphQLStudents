extend schema
  @link(
    url: "https://specs.apollo.dev/federation/v2.3"
    import: ["@key"]
  )

#Entidad Cliente conocida por su identificador federado
type Cliente @key(fields: "id") {
  id: ID!
  puntos: Int!
}


#Consulta auxiliar para verificar que Beneficios está disponible
type Query {
  estadoBeneficios: String!
}
